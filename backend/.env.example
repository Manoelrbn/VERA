# Copie este arquivo para .env e preencha.

# Sem DATABASE_URL o backend usa um arquivo SQLite local (bom para desenvolver).
# Em produção use Postgres, por exemplo:
# DATABASE_URL=postgresql+psycopg://vera:senha@localhost:5432/vera
DATABASE_URL=

# Gere um valor longo e aleatório: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-isto

# Sem chave, a Vera roda em "modo demonstração" com respostas de exemplo.
OPENAI_API_KEY=
# Deixe vazio para usar a OpenAI. Para outro provedor compatível, coloque o endereço dele.
OPENAI_BASE_URL=
# Modelo para tarefas pesadas (análise do edital, conversa) e para tarefas leves (questões).
OPENAI_MODELO_PRINCIPAL=gpt-4o
OPENAI_MODELO_RAPIDO=gpt-4o-mini

# --- Para testar de graça com o OpenRouter, troque as 4 linhas acima por: ---
# Chave gratuita em https://openrouter.ai/keys (modelos ":free" têm limite diário de pedidos)
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODELO_PRINCIPAL=nvidia/nemotron-3.5-super-vl:free
# OPENAI_MODELO_RAPIDO=nvidia/nemotron-3.5-super-vl:free
# Os modelos gratuitos mudam com frequência e às vezes ficam congestionados (erro 429).
# Lista atual: https://openrouter.ai/models?max_price=0

# Endereço do frontend, para liberar o CORS.
FRONTEND_URL=http://localhost:5173

# Contatos de suporte que aparecem para o aluno.
SUPORTE_EMAIL=contato@vera.com.br
SUPORTE_WHATSAPP=5531999999999
